<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kira Creative AI</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #111111;          /* Fondo base */
            --card-bg: #181818;     /* Fondo de las tarjetas */
            --border: #282828;      /* Bordes sutiles */
            --input-bg: #1d1d1d;    /* Fondo de inputs */
            --accent: #00e676;      /* Verde vibrante */
            --accent-dim: #00c853;  /* Verde para hover */
            --text-p: #ffffff;      /* Texto principal */
            --text-s: #a0a0a0;      /* Texto secundario */
            --shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        body {
            font-family: 'Inter', -apple-system, sans-serif;
            background-color: var(--bg);
            color: var(--text-p);
            display: flex;
            justify-content: center;
            padding: 40px 20px;
            margin: 0;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 480px;
            background-color: var(--card-bg);
            padding: 30px;
            border-radius: 20px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            height: fit-content;
        }

        h2 {
            font-size: 20px;
            font-weight: 600;
            margin: 0 0 30px 0;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        h2::before {
            content: '+';
            color: var(--accent);
            font-size: 24px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-size: 13px;
            color: var(--text-s);
            margin-bottom: 8px;
        }

        textarea, input[type="text"] {
            width: 100%;
            background-color: var(--input-bg);
            border: 1px solid var(--border);
            color: white;
            padding: 14px;
            border-radius: 12px;
            font-size: 14px;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

        textarea:focus, input[type="text"]:focus {
            outline: none;
            border-color: #444;
        }

        textarea {
            height: 100px;
            resize: none;
        }

        /* Input de archivo personalizado */
        .file-wrapper {
            position: relative;
            background-color: var(--input-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px;
            text-align: center;
            cursor: pointer;
            transition: 0.2s;
        }

        .file-wrapper:hover {
            border-color: var(--accent);
        }

        input[type="file"] {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }

        .file-label {
            font-size: 14px;
            color: var(--text-p);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        button#btnGenerar {
            background-color: var(--accent);
            color: #000;
            border: none;
            padding: 16px;
            border-radius: 14px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            width: 100%;
            margin-top: 10px;
            transition: background-color 0.2s;
        }

        button#btnGenerar:hover {
            background-color: var(--accent-dim);
        }

        /* Lógica de carga heredada intacta */
        #loadingOverlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(17,17,17,0.95);
            z-index: 1000;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .result {
            margin-top: 40px;
            display: none;
        }

        .gallery-item {
            background-color: var(--input-bg);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 24px;
            border: 1px solid var(--border);
            animation: fadeIn 0.5s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .gallery-item img {
            width: 100%;
            display: block;
        }

        .gallery-item a {
            display: block;
            padding: 15px;
            text-align: center;
            color: var(--accent);
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            background: #1d1d1d;
            border-top: 1px solid var(--border);
        }

        #miniLoader {
            display: none;
            padding: 20px;
            text-align: center;
            border: 1px dashed var(--border);
            border-radius: 16px;
            margin-top: 20px;
        }

        .spinner {
            width: 24px;
            height: 24px;
            border: 2px solid #333;
            border-top: 2px solid var(--accent);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto 10px;
        }

        /* Clase opcional por si quieres resaltar más el contenedor cuando hay archivo */
        .file-wrapper.has-file {
            border-color: var(--accent);
            background-color: rgba(0, 230, 118, 0.05);
        }

        @keyframes spin { 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>

    <div id="loadingOverlay">
        <div class="spinner"></div>
        <span id="statusText" style="font-size: 14px; color: var(--text-s);">Conectando...</span>
    </div>

    <div class="container">
        <h2>Nueva Campaña</h2>

        <form id="generatorForm">
            <div class="form-group">
                <label>Logotipo (Opcional)</label>
                <div class="file-wrapper">
                    <span class="file-label" id="fileNameDisplay">↑ Subir Logotipo</span>
                    <input type="file" name="logo" id="logoInput" accept="image/*">
                </div>
            </div>

            <div class="form-group">
                <label>Descripción Detallada</label>
                <textarea name="prompt" placeholder="Describe de qué trata la campaña publicitaria..." required></textarea>
            </div>

            <div class="form-group">
                <label>Colores preferidos</label>
                <input type="text" name="colors" placeholder="Ej: Blanco y Negro">
            </div>

            <button type="submit" id="btnGenerar">Crear Campaña</button>
        </form>

        <div id="resultContainer" class="result">
            <div id="gallery"></div>
            
            <div id="miniLoader">
                <div class="spinner"></div>
                <span style="font-size: 12px; color: var(--text-s);">Creando siguiente propuesta...</span>
            </div>
        </div>
    </div>

<script>
    // Tu lógica se mantiene 100% igual para asegurar que el streaming funcione
    const form = document.getElementById('generatorForm');
    const overlay = document.getElementById('loadingOverlay');
    const miniLoader = document.getElementById('miniLoader');
    const gallery = document.getElementById('gallery');
    const resultContainer = document.getElementById('resultContainer');
    const statusText = document.getElementById('statusText');

    const CHUNK_DELIMITER = "---KIRA_CHUNK_END---";
    const TOTAL_EXPECTED = 3;

    const logoInput = document.getElementById('logoInput');
    const fileNameDisplay = document.getElementById('fileNameDisplay');

    logoInput.addEventListener('change', function() {
        if (this.files && this.files.length > 0) {
            // Obtenemos el nombre del archivo
            const fileName = this.files[0].name;
            
            // Cambiamos el texto y el estilo para dar feedback visual
            fileNameDisplay.innerText = `✅ ${fileName}`;
            fileNameDisplay.style.color = "var(--accent)"; // Se pone verde al subir
        } else {
            // Si se cancela la selección, vuelve al estado original
            fileNameDisplay.innerText = "↑ Subir Logotipo";
            fileNameDisplay.style.color = "var(--text-p)";
        }
    });

    form.onsubmit = async (e) => {
        e.preventDefault();
        gallery.innerHTML = "";
        resultContainer.style.display = "none";
        overlay.style.display = "flex";
        statusText.innerText = "Conectando con Gemini...";
        miniLoader.style.display = "none";
        
        let imagesReceived = 0;

        try {
            const formData = new FormData(form);
            const response = await fetch('/generar', {
                method: 'POST',
                body: formData
            });

            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let buffer = "";

            while (true) {
                const { value, done } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const parts = buffer.split(CHUNK_DELIMITER);
                buffer = parts.pop();

                parts.forEach(part => {
                    if (!part.trim()) return;

                    try {
                        const data = JSON.parse(part);

                        if (data.image) {
                            imagesReceived++;
                            overlay.style.display = "none";
                            resultContainer.style.display = "block";
                            
                            if (imagesReceived < TOTAL_EXPECTED) {
                                miniLoader.style.display = "block";
                            } else {
                                miniLoader.style.display = "none";
                            }

                            const item = document.createElement('div');
                            item.className = "gallery-item";
                            item.innerHTML = `
                                <img src="${data.image}">
                                <a href="${data.image}" download="propuesta-${data.index + 1}.png">
                                    Descargar Propuesta ${data.index + 1}
                                </a>
                            `;

                            gallery.appendChild(item);
                            
                            if (imagesReceived < TOTAL_EXPECTED) {
                                miniLoader.scrollIntoView({ behavior: "smooth" });
                            } else {
                                item.scrollIntoView({ behavior: "smooth" });
                            }
                        }
                    } catch (err) {
                        console.error("Error parseando chunk:", err);
                    }
                });
            }

        } catch (err) {
            console.error(err);
            alert("Error conectando al servidor");
        } finally {
            overlay.style.display = "none";
            if (imagesReceived >= TOTAL_EXPECTED || imagesReceived === 0) {
                miniLoader.style.display = "none";
            }
        }
    };
</script>
</body>
</html>